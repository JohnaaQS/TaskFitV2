gTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="330" height="74" as="geometry" /></mxCell><mxCell id="B_pe" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;interface (Spring Security)&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PasswordEncoder&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+encode(CharSequence): String&lt;br&gt;+matches(CharSequence, String): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#e6f0ff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="250" height="90" as="geometry" /></mxCell><mxCell id="B_jt" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;JwtTokenService&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="700" width="250" height="36" as="geometry" /></mxCell><mxCell id="B_au" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;record&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AuthenticatedUser&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;userId: UUID&lt;br&gt;role: Role" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="700" width="250" height="90" as="geometry" /></mxCell><mxCell id="B_ur" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;interface&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;UserRepository&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+existsByEmail(String): boolean&lt;br&gt;+findByEmail(String): Optional&amp;lt;User&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#e6f0ff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="920" width="420" height="90" as="geometry" /></mxCell><mxCell id="B_fp" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;FreelancerProfile&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;userId: UUID&lt;br&gt;postcode: String&lt;br&gt;motivationText: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1100" width="300" height="90" as="geometry" /></mxCell><mxCell id="B_u" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;id: UUID&lt;br&gt;name: String&lt;br&gt;email: String&amp;nbsp;&amp;nbsp;(unique, lowercase)&lt;br&gt;passwordHash: String&lt;br&gt;role: Role" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="1100" width="340" height="122" as="geometry" /></mxCell><mxCell id="B_cp" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ClientProfile&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;userId: UUID&lt;br&gt;companyName: String&lt;br&gt;location: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="1100" width="300" height="90" as="geometry" /></mxCell><mxCell id="B_ro" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;enumeration&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Role&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;Freelancer&lt;br&gt;Client" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="1180" width="200" height="90" as="geometry" /></mxCell><mxCell id="note" value="Solid arrow: uses (association). Dashed arrow: dependency. Dashed with hollow triangle: implements.&lt;br&gt;Blue boxes are interfaces. A user has either a FreelancerProfile or a ClientProfile, created empty at registration.&lt;br&gt;AuthService and ClientProfileService throw the exceptions in the Exceptions box. The handler turns them into HTTP status codes.&lt;br&gt;Target design. Class and DTO names follow the current code. Not built yet: AuthController, AuthService, the repositories, the JWT classes, FreelancerProfile and InvalidCredentialsException." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#4a5a7a;" vertex="1" parent="1"><mxGeometry x="40" y="1292" width="1500" height="76" as="geometry" /></mxCell><mxCell id="E0" value="" style="html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;endSize=10;" edge="1" parent="1" source="B_ac" target="B_as"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E1" value="" style="html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;endSize=10;" edge="1" parent="1" source="B_cpc" target="B_cps"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E2" value="" style="html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=open;endSize=10;" edge="1" parent="1" source="B_jf" ta