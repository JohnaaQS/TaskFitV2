tml=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="280" height="74" as="geometry" /></mxCell><mxCell id="B_cpc" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;@RestController&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ClientProfileController&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+saveProfile(ClientProfileRequest):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ClientProfileResponse&lt;br&gt;user id comes from the token" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="70" width="330" height="106" as="geometry" /></mxCell><mxCell id="B_d1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;record&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;UserRequest&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;name: String&lt;br&gt;password: String&lt;br&gt;email: String&lt;br&gt;role: Role" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1395" y="85" width="160" height="122" as="geometry" /></mxCell><mxCell id="B_d2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;&amp;laquo;record&amp;raquo;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;LoginRequest&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;email: String&lt;br&gt;password: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=11;" vertex="1" parent="1"><mxGeometr