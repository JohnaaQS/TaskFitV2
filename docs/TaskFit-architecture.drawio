<mxfile host="app.diagrams.net" compressed="false"><diagram id="ctx" name="1 - System context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx_f" value="&lt;b&gt;Freelancer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Builds a profile with skills and&lt;br&gt;availability, applies to jobs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8edf7;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="240" height="100" as="geometry"/></mxCell><mxCell id="ctx_c" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Posts jobs, reviews matches and&lt;br&gt;applications, accepts one" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8edf7;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="240" height="100" as="geometry"/></mxCell><mxCell id="ctx_k" value="&lt;b&gt;Klusplatform&lt;/b&gt;&lt;br&gt;[Software system]&lt;br&gt;Marketplace that matches freelancers&lt;br&gt;to jobs and books accepted applications" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dbe8ff;strokeColor=#2f5fb3;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="360" height="120" as="geometry"/></mxCell><mxCell id="ctx_ai" value="&lt;b&gt;AI API&lt;/b&gt;&lt;br&gt;[External system, LLM]&lt;br&gt;Extracts strengths and weaknesses&lt;br&gt;from a motivation text" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#8a8a8a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="360" height="100" as="geometry"/></mxCell><mxCell id="ctx_e1" value="Uses via browser" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="ctx_f" target="ctx_k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx_e2" value="Uses via browser" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="ctx_c" target="ctx_k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx_e3" value="Sends motivation text,&lt;br&gt;receives analysis (JSON)" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctx_k" target="ctx_ai"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cont" name="2 - Containers and layers"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cont_bound" value="&lt;b&gt;Spring Boot API&lt;/b&gt;&lt;br&gt;[Container: Java, REST + JSON]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=none;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="580" y="30" width="520" height="790" as="geometry"/></mxCell><mxCell id="cont_fr" value="&lt;b&gt;Freelancer&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8edf7;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="170" height="64" as="geometry"/></mxCell><mxCell id="cont_cl" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8edf7;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="30" width="170" height="64" as="geometry"/></mxCell><mxCell id="cont_react" value="&lt;b&gt;React frontend&lt;/b&gt;&lt;br&gt;[Container: React, browser]&lt;br&gt;Screens for freelancers and clients,&lt;br&gt;calls the API with a token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e6f0ff;strokeColor=#2f5fb3;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="340" height="110" as="geometry"/></mxCell><mxCell id="cont_pres" value="Presentation layer" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=6;fillColor=#dfe7f5;swimlaneFillColor=#f7f9fd;strokeColor=#4a5a7a;fontColor=#1f2a44;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="460" height="170" as="geometry"/></mxCell><mxCell id="cont_ctrl" value="&lt;b&gt;Controllers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_pres"><mxGeometry x="20" y="45" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_dto" value="&lt;b&gt;DTOs (request / response)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_pres"><mxGeometry x="240" y="45" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_exh" value="&lt;b&gt;ExceptionHandler&lt;/b&gt;&lt;br&gt;(@RestControllerAdvice)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_pres"><mxGeometry x="20" y="105" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_tf" value="&lt;b&gt;Token filter&lt;/b&gt;&lt;br&gt;(checks every request)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_pres"><mxGeometry x="240" y="105" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_bl" value="Business logic layer" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=6;fillColor=#dfe7f5;swimlaneFillColor=#f7f9fd;strokeColor=#4a5a7a;fontColor=#1f2a44;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="330" width="460" height="300" as="geometry"/></mxCell><mxCell id="cont_us" value="&lt;b&gt;ClientProfileService&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="20" y="45" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_au" value="&lt;b&gt;AuthService&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="240" y="45" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_js" value="&lt;b&gt;JobService&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="20" y="105" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_as" value="&lt;b&gt;ApplicationService&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="240" y="105" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_ms" value="&lt;b&gt;MatchingService&lt;/b&gt;&lt;br&gt;(score, no AI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="20" y="165" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_ais" value="&lt;b&gt;AiAnalysisService&lt;/b&gt;&lt;br&gt;(separate from the score)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="240" y="165" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_ns" value="&lt;b&gt;NotificationService&lt;/b&gt;&lt;br&gt;(SSE, Could)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;dashed=1;" vertex="1" parent="cont_bl"><mxGeometry x="20" y="225" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_pe" value="&lt;b&gt;PasswordEncoder&lt;/b&gt;&lt;br&gt;(bcrypt hash)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_bl"><mxGeometry x="240" y="225" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_da" value="Data access layer" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=6;fillColor=#dfe7f5;swimlaneFillColor=#f7f9fd;strokeColor=#4a5a7a;fontColor=#1f2a44;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="460" height="110" as="geometry"/></mxCell><mxCell id="cont_rep" value="&lt;b&gt;Repositories&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_da"><mxGeometry x="20" y="45" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_pc" value="&lt;b&gt;Postcode lookup table&lt;/b&gt;&lt;br&gt;(postcode to coordinates)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="cont_da"><mxGeometry x="240" y="45" width="200" height="44" as="geometry"/></mxCell><mxCell id="cont_db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL 17, Docker]&lt;br&gt;Tables are created from the entities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#4a5a7a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="690" width="220" height="100" as="geometry"/></mxCell><mxCell id="cont_aix" value="&lt;b&gt;AI API&lt;/b&gt;&lt;br&gt;[External system, LLM]&lt;br&gt;Called by AiAnalysisService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eeeeee;strokeColor=#8a8a8a;fontColor=#1f2a44;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="380" width="220" height="100" as="geometry"/></mxCell><mxCell id="cont_note" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;Dashed = planned or optional (Could)&lt;br&gt;Calls only go downwards: presentation,&lt;br&gt;business logic, data access&lt;br&gt;DTOs stay in the presentation layer, services&lt;br&gt;only know domain objects&lt;br&gt;Stateless: the API stores no session,&lt;br&gt;every request carries a token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#4a5a7a;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="500" height="170" as="geometry"/></mxCell><mxCell id="cont_e1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="cont_fr" target="cont_react"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="cont_cl" target="cont_react"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e3" value="REST + JSON over HTTPS&lt;br&gt;token in Authorization header" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cont_react" target="cont_pres"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e4" value="Live matches (SSE, Could)" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="cont_bl" target="cont_react"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e5" value="calls" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cont_pres" target="cont_bl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e6" value="calls" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cont_bl" target="cont_da"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e7" value="HTTPS + JSON" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cont_bl" target="cont_aix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cont_e8" value="JPA" style="endArrow=classic;html=1;rounded=0;strokeColor=#4a5a7a;fontSize=11;fontColor=#1f2a44;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cont_da" target="cont_db"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>